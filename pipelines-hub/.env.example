# Todas opcionales. Las cuentas y organizaciones se agregan desde el front.

# Clave Fernet para cifrar los tokens. Si no se define, se genera una y se guarda
# en el volumen (/data/secret.key) junto a la base.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HUB_SECRET_KEY=

# Cadencias del poller (segundos)
# HUB_REPO_LIST_INTERVAL=60
# HUB_HOT_POLL_INTERVAL=15
# HUB_WARM_POLL_INTERVAL=60
# HUB_COLD_POLL_INTERVAL=600
# HUB_DEPLOYMENTS_INTERVAL=1800

# Repos seguidos por defecto al agregar una org/workspace
# HUB_DEFAULT_MAX_REPOS=30
# HUB_DEFAULT_ACTIVE_DAYS=45
