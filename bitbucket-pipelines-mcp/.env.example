# Bitbucket Cloud credentials (API Tokens)
# App passwords are deprecated - use API tokens instead
# Create an API token at: Bitbucket Settings > Atlassian account settings > Security > API tokens

# Required: Your Atlassian account email (NOT your Bitbucket username)
BITBUCKET_EMAIL=your-email@example.com

# Required: API token with scopes for Bitbucket
# Token must have: Repositories (read/write), Pull requests (read/write), Pipelines (read/write)
BITBUCKET_API_TOKEN=ATAT...your-api-token

# Optional: Default workspace (can be overridden in tool calls)
DEFAULT_WORKSPACE=your-workspace

# Optional: API configuration
# API_BASE_URL=https://api.bitbucket.org/2.0
# TIMEOUT=30.0
